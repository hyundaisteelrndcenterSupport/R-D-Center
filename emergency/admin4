/********************************************************
 * 8. 중복 훈련 차단
 ********************************************************/
async function findDuplicateTeamConflicts({ excludeTrainingId, startDate, endDate, teamInfos }) {
  if (!teamInfos || teamInfos.length === 0) return [];

  const teamKeySet = new Set(teamInfos.map((t) => t.teamKey));
  const teamNameByKey = new Map(teamInfos.map((t) => [t.teamKey, t.team]));

  const snapshot = await db.collection("emergencyTrainings")
    .where("startAt", "<=", firebase.firestore.Timestamp.fromDate(endDate))
    .get();

  const conflicts = [];

  snapshot.docs.forEach((doc) => {
    if (doc.id === excludeTrainingId) return;

    const data = doc.data();

    if (!data.startAt || !data.endAt) return;

    const otherEnd = data.endAt.toDate();
    const otherStart = data.startAt.toDate();

    const isOverlap =
      otherStart.getTime() <= endDate.getTime() &&
      otherEnd.getTime() >= startDate.getTime();

    if (!isOverlap) return;

    let otherTeamKeys = [];

    if (Array.isArray(data.teamKeys)) {
      otherTeamKeys = data.teamKeys;
    } else if (Array.isArray(data.teams)) {
      otherTeamKeys = data.teams.map((team) => normalizeTeamKey(team));
    }

    const duplicatedKeys = otherTeamKeys.filter((key) => teamKeySet.has(key));

    if (duplicatedKeys.length > 0) {
      conflicts.push({
        trainingName: data.trainingName || doc.id,
        period: `${formatKst(data.startAt, false)} ~ ${formatKst(data.endAt, false)}`,
        teams: duplicatedKeys.map((key) => teamNameByKey.get(key) || key)
      });
    }
  });

  return conflicts;
}

function buildConflictMessage(conflicts) {
  const lines = [
    "동일 시간대에 같은 팀이 포함된 다른 비상대응훈련이 있습니다.",
    "",
    "1개 팀은 동일 시간대에 2개 이상의 비상대응훈련에 참여할 수 없도록 설정했습니다.",
    ""
  ];

  conflicts.slice(0, 8).forEach((conflict, index) => {
    lines.push(
      `${index + 1}. ${conflict.trainingName}`,
      `   시간: ${conflict.period}`,
      `   중복 팀: ${conflict.teams.join(", ")}`,
      ""
    );
  });

  if (conflicts.length > 8) {
    lines.push(`외 ${conflicts.length - 8}건의 중복 훈련이 더 있습니다.`);
  }

  return lines.join("\n");
}

