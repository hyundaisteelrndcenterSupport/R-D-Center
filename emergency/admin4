 ********************************************************/
function getDashboardLinkRows() {
  const rows = [];

  const headquartersList = getUniqueOrgInfos("headquarters");
  const divisionList = getUniqueOrgInfos("division");
  const officeList = getUniqueOrgInfos("office");

  headquartersList.forEach((item) => {
    rows.push({
      role: "본부장",
      name: item.name,
      count: item.count,
      url: buildDashboardUrl("headquarters", item.name)
    });
  });

  divisionList.forEach((item) => {
    rows.push({
      role: "사업부장",
      name: item.name,
      count: item.count,
      url: buildDashboardUrl("division", item.name)
    });
  });

  officeList.forEach((item) => {
    rows.push({
      role: "실장",
      name: item.name,
      count: item.count,
      url: buildDashboardUrl("office", item.name)
    });
  });

  return rows;
}

function buildDashboardUrl(view, name) {
  const url = new URL(location.href);

  url.pathname = replaceLastPathSegment(url.pathname, "dashboard");

  const search = new URLSearchParams();

  search.set("view", view);

  if (view === "headquarters") {
    search.set("headquarters", name);
  } else if (view === "division") {
    search.set("division", name);
  } else if (view === "office") {
    search.set("office", name);
  }

  url.search = search.toString();
  url.hash = "";

  return url.toString();
}

function getUniqueOrgInfos(field) {
  const map = new Map();

  participants.forEach((p) => {
    const name = String(p[field] || "").trim();

    if (!name || name === "-") return;

    const key = normalizeText(name);

    if (!map.has(key)) {
      map.set(key, {
        name,
        count: 0
      });
    }

    map.get(key).count += 1;
  });

  return Array.from(map.values()).sort((a, b) => a.name.localeCompare(b.name, "ko"));
}

