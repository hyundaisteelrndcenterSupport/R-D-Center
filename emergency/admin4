 ********************************************************/
function getAttendanceRows() {
  const internalRows = participants.map((p) => {
    const status = getPersonStatus(p);
    const detailText = getPersonDetail(p);

    return {
      source: "internal",
      order: Number(p.order || 0),
      officeOrOrg: p.office || "",
      teamOrAffiliation: p.team || "",
      name: p.name || "",
      status,
      statusClass: getStatusClass(status),
      detailText
    };
  });

  const externalRows = externalParticipants.map((p, index) => ({
    source: "external",
    order: 100000 + index,
    officeOrOrg: "협력·외주",
    teamOrAffiliation: p.affiliation ? p.affiliation : "협력·외주",
    name: p.name || "",
    status: "대피완료",
    statusClass: "complete",
    detailText: p.checkTime ? formatKst(p.checkTime) : ""
  }));

  return [...internalRows, ...externalRows].sort((a, b) => a.order - b.order);
}

function getPersonStatus(person) {
  if (person.status) return person.status;
  if (person.checked === true) return "대피완료";
  if (person.absenceReason) return person.absenceReason;
  return "확인중";
}

function getPersonDetail(person) {
  const status = getPersonStatus(person);

  if (status === "대피완료") {
    return person.checkTime ? formatKst(person.checkTime) : "";
  }

  if (isAbsenceStatus(status)) {
    if (status === "휴가" && !person.absenceDetail) return "";
    return person.absenceDetail || "";
  }

  return "";
}

function getStatusClass(status) {
  if (status === "대피완료") return "complete";
  if (status === "확인중") return "checking";
  if (isAbsenceStatus(status)) return "absence";
  return "";
}

function isAbsenceStatus(status) {
  return ["타 본부", "휴가", "출장", "외출"].includes(status);
}

