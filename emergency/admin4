function buildParticipantUrl({ mode, team, teamKey }) {
  const url = new URL(location.href);

  url.pathname = replaceLastPathSegment(url.pathname, "participant");

  const search = new URLSearchParams();

  if (mode === "main") {
    search.set("trainingId", selectedTrainingId);
  }

  if (mode === "external") {
    search.set("trainingId", selectedTrainingId);
    search.set("external", "1");
  }

  if (mode === "teamDashboard") {
    search.set("view", "team");
    search.set("team", team);
    search.set("teamKey", teamKey || normalizeTeamKey(team));
  }

  url.search = search.toString();
  url.hash = "";

  return url.toString();
}

