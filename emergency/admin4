    const trainingName = $("trainingName").value.trim() || "비상대응훈련";

    const excelRows = [
      ["순번", "본부", "사업부", "실", "팀/소속", "사번", "성명", "팀장여부", "상태", "출석 시간 / 부재내용"]
    ];

    participants.forEach((p, index) => {
      excelRows.push([
        index + 1,
        p.headquarters || "",
        p.division || "",
        p.office || "",
        p.team || "",
        p.empNo || "",
        p.name || "",
        p.isLeader ? "해당" : p.leaderFlag || "미해당",
        getPersonStatus(p),
        getPersonDetail(p)
      ]);
    });

    externalParticipants.forEach((p, index) => {
      excelRows.push([
        participants.length + index + 1,
        "",
        "",
        "협력·외주",
        p.affiliation || "협력·외주",
        "",
        p.name || "",
        "",
        "대피완료",
        p.checkTime ? formatKst(p.checkTime) : ""
      ]);
    });

    const ws = XLSX.utils.aoa_to_sheet(excelRows);

    ws["!cols"] = [
      { wch: 8 },
      { wch: 18 },
      { wch: 18 },
      { wch: 20 },
      { wch: 24 },
      { wch: 14 },
      { wch: 14 },
      { wch: 12 },
      { wch: 14 },
      { wch: 30 }
    ];

    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "출결현황");

    const safeName = trainingName.replace(/[\\/:*?"<>|]/g, "_");

    XLSX.writeFile(wb, `${safeName}_출결현황.xlsx`);
  } catch (err) {
    if (err.message !== "훈련 미선택") {
      console.error(err);
      alert("엑셀 다운로드 중 오류가 발생했습니다.");
    }
  }
}

/********************************************************
 * 15. 보조 함수
 ********************************************************/
function getTeamInfosFromParticipants(list) {
  const map = new Map();

  list.forEach((p) => {
    const team = String(p.team || "").trim();
    if (!team) return;

    const teamKey = normalizeTeamKey(team);

    if (!map.has(teamKey)) {
      map.set(teamKey, {
        team,
        teamKey,
        count: 0
      });
    }

    map.get(teamKey).count += 1;
  });

  return Array.from(map.values()).sort((a, b) => a.team.localeCompare(b.team, "ko"));
}

function buildOrgPayload(list) {
  const headquarters = getUniqueValuesFromList(list, "headquarters");
  const divisions = getUniqueValuesFromList(list, "division");
  const offices = getUniqueValuesFromList(list, "office");

  return {
    headquarters,
    headquartersKeys: headquarters.map(normalizeText),
    divisions,
    divisionKeys: divisions.map(normalizeText),
    offices,
    officeKeys: offices.map(normalizeText)
  };
}

function getUniqueValuesFromList(list, field) {
  const map = new Map();

  list.forEach((p) => {
    const value = String(p[field] || "").trim();

    if (!value || value === "-") return;

    map.set(normalizeText(value), value);
  });

  return Array.from(map.values()).sort((a, b) => a.localeCompare(b, "ko"));
}

function mergeParticipantLists(oldList, newList) {
  const map = new Map();

  oldList.forEach((p) => {
    if (!p.empNo) return;

    map.set(String(p.empNo), {
      ...p,
      teamKey: normalizeTeamKey(p.team)
    });
  });

  newList.forEach((p) => {
    map.set(String(p.empNo), {
      ...map.get(String(p.empNo)),
      ...p,
      teamKey: normalizeTeamKey(p.team)
    });
  });

  return Array.from(map.values()).sort((a, b) => Number(a.order || 0) - Number(b.order || 0));
}

function isLeaderFlag(value) {
  const v = normalizeText(value);

  return (
    v === "해당" ||
    v === "팀장" ||
    v === "y" ||
    v === "yes" ||
    v === "true"
  );
}

function normalizeText(value) {
  return String(value || "")
    .trim()
    .replace(/\s+/g, "")
    .replaceAll("ㆍ", "·")
    .replaceAll("/", "·")
    .toLowerCase();
}

function normalizeTeamKey(value) {
  return normalizeText(value);
}

function timestampToMillis(value) {
  if (!value) return 0;

  if (typeof value.toMillis === "function") {
    return value.toMillis();
  }

  if (typeof value.toDate === "function") {
    return value.toDate().getTime();
  }

  return new Date(value).getTime() || 0;
}

function makeSafeDocId(value) {
  return String(value).trim().replace(/[\/\\#?]/g, "_");
}

function replaceLastPathSegment(pathname, nextSegment) {
  return pathname.replace(/[^/]*$/, nextSegment);
}

function setMessage(id, text, type) {
  const el = $(id);
  if (!el) return;

  el.textContent = text || "";
  el.className = `message ${type || ""}`;
}

function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function escapeAttr(value) {
  return escapeHtml(value).replaceAll("`", "&#096;");
}

