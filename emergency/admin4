/********************************************************
 * 3. Firebase 안전 초기화
 ********************************************************/
function initFirebaseSafely() {
  try {
    if (typeof firebase === "undefined") {
      throw new Error("Firebase SDK가 로드되지 않았습니다.");
    }

    if (!firebase.apps.length) {
      firebase.initializeApp(firebaseConfig);
    }

    db = firebase.firestore();
    firebaseReady = true;

    setFirebaseState("Firebase 연결 준비 완료", "ok");
    setMessage("trainingMessage", "Firebase 연결 준비가 완료되었습니다.", "ok");

    return true;
  } catch (err) {
    console.error("Firebase 초기화 오류:", err);

    db = null;
    firebaseReady = false;

    setFirebaseState("Firebase 연결 실패 · 설정값 확인 필요", "error");
    setMessage(
      "trainingMessage",
      "Firebase 연결에 실패했습니다. firebaseConfig 값, API Key 제한, Firestore 생성 여부를 확인해주세요.",
      "error"
    );

    return false;
  }
}

function ensureFirebaseReady() {
  if (!firebaseReady || !db) {
    setMessage(
      "trainingMessage",
      "Firebase가 연결되지 않았습니다. firebaseConfig 또는 API Key 제한을 확인해주세요.",
      "error"
    );
    throw new Error("Firebase 연결 실패");
  }
}

function setFirebaseState(text, type) {
  const el = $("firebaseState");
  if (!el) return;

  el.textContent = text;
  el.className = `connection-state ${type || ""}`;
}

function handleFirestoreError(err, place) {
  console.error(`${place} 오류:`, err);

  let message = `${place} 중 오류가 발생했습니다.`;

  if (err && err.code === "permission-denied") {
    message =
      `${place} 실패: Firestore 보안 규칙 권한이 없습니다. ` +
      `Rules에서 emergencyTrainings 읽기/쓰기를 허용해야 합니다.`;
  } else if (err && err.code === "failed-precondition") {
    message =
      `${place} 실패: Firestore 인덱스 또는 데이터베이스 설정이 필요할 수 있습니다.`;
  } else if (err && err.message) {
    message = `${place} 실패: ${err.message}`;
  }

  setFirebaseState("Firebase 오류 발생", "error");
  setMessage("trainingMessage", message, "error");
}

/********************************************************
 * 4. 한국시간 유틸
 ********************************************************/
function pad2(value) {
  return String(value).padStart(2, "0");
}

function getKstDate(date = new Date()) {
  return new Date(date.getTime() + 9 * 60 * 60 * 1000);
}

function getKstParts(date = new Date()) {
  const kst = getKstDate(date);

  return {
    year: kst.getUTCFullYear(),
    month: kst.getUTCMonth() + 1,
    day: kst.getUTCDate(),
    hour: kst.getUTCHours(),
    minute: kst.getUTCMinutes(),
    second: kst.getUTCSeconds()
  };
}

function toKstDateTimeLocalValue(date) {
  const p = getKstParts(date);
  return `${p.year}-${pad2(p.month)}-${pad2(p.day)}T${pad2(p.hour)}:${pad2(p.minute)}`;
}

function kstDateTimeLocalToDate(value) {
  if (!value) {
    throw new Error("출석 가능 시간을 입력해주세요.");
  }

  const [datePart, timePart] = value.split("T");
  const [year, month, day] = datePart.split("-").map(Number);
  const [hour, minute] = timePart.split(":").map(Number);

  return new Date(Date.UTC(year, month - 1, day, hour - 9, minute, 0));
}

function formatKst(value, withSeconds = true) {
  if (!value) return "";

  let date;

  if (typeof value.toDate === "function") {
    date = value.toDate();
  } else {
    date = new Date(value);
  }

  const p = getKstParts(date);
  const time = withSeconds
    ? `${pad2(p.hour)}:${pad2(p.minute)}:${pad2(p.second)}`
    : `${pad2(p.hour)}:${pad2(p.minute)}`;

  return `${p.year}.${pad2(p.month)}.${pad2(p.day)}. ${time}`;
}

function updateClock() {
  const clockEl = $("kstClock");
  if (!clockEl) return;

  const p = getKstParts();

  clockEl.textContent =
    `${p.year}.${pad2(p.month)}.${pad2(p.day)} ${pad2(p.hour)}:${pad2(p.minute)}:${pad2(p.second)}`;

  if (currentTraining) {
    renderSelectedTrainingInfo(currentTraining);
  }
}

function setDefaultDateTime() {
  const now = new Date();
  const afterTwoHours = new Date(now.getTime() + 2 * 60 * 60 * 1000);

  $("startAt").value = toKstDateTimeLocalValue(now);
  $("endAt").value = toKstDateTimeLocalValue(afterTwoHours);
}

/********************************************************
 * 5. Firestore 경로
 ********************************************************/
function trainingCollection() {
  ensureFirebaseReady();
  return db.collection("emergencyTrainings");
}

function requireSelectedTraining() {
  if (!selectedTrainingId) {
    alert("먼저 훈련을 저장하거나 저장된 훈련을 선택해주세요.");
    throw new Error("훈련 미선택");
  }

  return selectedTrainingId;
}

function selectedTrainingRef() {
  ensureFirebaseReady();
  return db.collection("emergencyTrainings").doc(requireSelectedTraining());
}

function participantsRef() {
  return selectedTrainingRef().collection("participants");
}

function externalParticipantsRef() {
  return selectedTrainingRef().collection("externalParticipants");
}

/********************************************************
 * 6. 훈련 생성 / 저장 / 불러오기
 ********************************************************/
function startNewTraining() {
  selectedTrainingId = "";
  currentTraining = null;
  participants = [];
  externalParticipants = [];

  if (unsubscribeParticipants) unsubscribeParticipants();
  if (unsubscribeExternalParticipants) unsubscribeExternalParticipants();

  $("trainingName").value = "";
  setDefaultDateTime();

  renderSelectedTrainingInfo(null);
  renderTrainingSelect();
  renderAll();

  setMessage("trainingMessage", "새로운 훈련 정보를 입력한 뒤 [훈련 저장]을 누르세요.", "warn");
  setMessage("memberMessage", "", "");
}

async function saveTraining() {
  try {
    ensureFirebaseReady();

    const trainingName = $("trainingName").value.trim();
    const startDate = kstDateTimeLocalToDate($("startAt").value);
    const endDate = kstDateTimeLocalToDate($("endAt").value);

    if (!trainingName) {
      alert("훈련명을 입력해주세요.");
      return;
    }

    if (endDate.getTime() <= startDate.getTime()) {
      alert("출석 종료 시간은 시작 시간보다 늦어야 합니다.");
      return;
    }

    const teamInfos = getTeamInfosFromParticipants(participants);

    const conflicts = await findDuplicateTeamConflicts({
      excludeTrainingId: selectedTrainingId,
      startDate,
      endDate,
      teamInfos
    });

    if (conflicts.length > 0) {
      alert(buildConflictMessage(conflicts));
      return;
    }

    const orgPayload = buildOrgPayload(participants);

    const payload = {
      trainingName,
      startAt: firebase.firestore.Timestamp.fromDate(startDate),
      endAt: firebase.firestore.Timestamp.fromDate(endDate),
      timeZone: "Asia/Seoul",
      teams: teamInfos.map((t) => t.team),
      teamKeys: teamInfos.map((t) => t.teamKey),
      teamSummary: teamInfos,
      participantCount: participants.length,
      leaderCount: participants.filter((p) => p.isLeader === true || normalizeText(p.leaderFlag) === "해당").length,
      ...orgPayload,
      updatedAt: firebase.firestore.FieldValue.serverTimestamp()
    };

    let ref;

    if (selectedTrainingId) {
      ref = db.collection("emergencyTrainings").doc(selectedTrainingId);
      await ref.set(payload, { merge: true });
    } else {
      ref = db.collection("emergencyTrainings").doc();
      selectedTrainingId = ref.id;

      await ref.set({
        trainingId: selectedTrainingId,
        ...payload,
        externalCounter: 0,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      });
    }

    await loadTrainingById(selectedTrainingId);

    setMessage("trainingMessage", "훈련이 저장되었습니다.", "ok");
  } catch (err) {
    if (err.message === "Firebase 연결 실패") return;
    handleFirestoreError(err, "훈련 저장");
  }
}

function subscribeTrainingList() {
  try {
    ensureFirebaseReady();

    if (unsubscribeTrainings) unsubscribeTrainings();

    unsubscribeTrainings = db.collection("emergencyTrainings").onSnapshot(
      (snapshot) => {
        setFirebaseState("Firebase 연결 정상", "ok");

        trainings = snapshot.docs.map((doc) => ({
          id: doc.id,
          ...doc.data()
        }));

        trainings.sort((a, b) => {
          const bTime = timestampToMillis(b.updatedAt || b.createdAt);
          const aTime = timestampToMillis(a.updatedAt || a.createdAt);
          return bTime - aTime;
        });

        renderTrainingSelect();

        if (!selectedTrainingId && trainings.length > 0) {
          loadTrainingById(trainings[0].id);
        }
      },
      (err) => {
        handleFirestoreError(err, "훈련 목록 불러오기");
      }
    );
  } catch (err) {
    if (err.message !== "Firebase 연결 실패") {
      handleFirestoreError(err, "훈련 목록 연결");
    }
  }
}

async function selectTrainingFromDropdown(id) {
  if (!id) return;
  await loadTrainingById(id);
}

async function loadTrainingById(id) {
  try {
    ensureFirebaseReady();

    const doc = await db.collection("emergencyTrainings").doc(id).get();

    if (!doc.exists) {
      alert("해당 훈련을 찾을 수 없습니다.");
      return;
    }

    selectedTrainingId = id;
    currentTraining = {
      id: doc.id,
      ...doc.data()
    };

    $("trainingName").value = currentTraining.trainingName || "";

    if (currentTraining.startAt) {
      $("startAt").value = toKstDateTimeLocalValue(currentTraining.startAt.toDate());
    }

    if (currentTraining.endAt) {
      $("endAt").value = toKstDateTimeLocalValue(currentTraining.endAt.toDate());
    }

    renderTrainingSelect();
    renderSelectedTrainingInfo(currentTraining);
    subscribeParticipants();
    subscribeExternalParticipants();

    setMessage("trainingMessage", "훈련 정보를 불러왔습니다.", "ok");
  } catch (err) {
    if (err.message === "Firebase 연결 실패") return;
    handleFirestoreError(err, "훈련 정보 불러오기");
  }
}

function renderTrainingSelect() {
  const select = $("trainingSelect");

  if (trainings.length === 0) {
    select.innerHTML = `<option value="">저장된 훈련이 없습니다.</option>`;
    return;
  }

  select.innerHTML = `
    <option value="">훈련을 선택하세요</option>
    ${trainings.map((training) => {
      const name = training.trainingName || "이름 없는 훈련";
      const period = training.startAt ? formatKst(training.startAt, false) : "시간 미설정";

      return `
        <option value="${escapeAttr(training.id)}">
          ${escapeHtml(name)} · ${escapeHtml(period)}
        </option>
      `;
    }).join("")}
  `;

  select.value = selectedTrainingId || "";
}

function renderSelectedTrainingInfo(training) {
  const badge = $("trainingStatusBadge");

  if (!training) {
    $("selectedTrainingName").textContent = "-";
    $("selectedTrainingId").textContent = "-";
    $("selectedTrainingPeriod").textContent = "-";
    badge.textContent = "미선택";
    badge.className = "badge empty";
    return;
  }

  $("selectedTrainingName").textContent = training.trainingName || "-";
  $("selectedTrainingId").textContent = training.id || selectedTrainingId || "-";

  const period =
    training.startAt && training.endAt
      ? `${formatKst(training.startAt, false)} ~ ${formatKst(training.endAt, false)}`
      : "-";

  $("selectedTrainingPeriod").textContent = period;

  const status = getTrainingStatus(training);

  badge.textContent = status.text;
  badge.className = `badge ${status.className}`;
}

function getTrainingStatus(training) {
  if (!training || !training.startAt || !training.endAt) {
    return {
      text: "시간 미설정",
      className: "empty"
    };
  }

  const now = Date.now();
  const start = training.startAt.toDate().getTime();
  const end = training.endAt.toDate().getTime();

  if (now < start) {
    return {
      text: "대기",
      className: "wait"
    };
  }

  if (now >= start && now <= end) {
    return {
      text: "출석 가능",
      className: "open"
    };
  }

  return {
    text: "종료",
    className: "closed"
  };
}

/********************************************************
 * 7. 참석자 입력 / 저장
 ********************************************************/
function parsePastedText(text) {
  const lines = text
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);

  const result = [];

  for (const line of lines) {
    let cols = splitPastedLine(line);

    cols = cols.map((value) => String(value || "").trim());

    if (isHeaderRow(cols)) continue;

    let person = null;

    if (cols.length >= 8) {
      const [orderRaw, headquarters, division, office, team, empNo, name, leaderFlagRaw] = cols;
      const order = Number(orderRaw);

      if (!order || !team || !empNo || !name) continue;

      const leaderFlag = leaderFlagRaw || "미해당";
      const isLeader = isLeaderFlag(leaderFlag);

      person = {
        order,
        headquarters: headquarters || "",
        division: division || "",
        office: office || "",
        team,
        teamKey: normalizeTeamKey(team),
        empNo: String(empNo),
        name,
        leaderFlag: isLeader ? "해당" : "미해당",
        isLeader
      };
    } else if (cols.length >= 4) {
      const [orderRaw, team, empNo, name] = cols;
      const order = Number(orderRaw);

      if (!order || !team || !empNo || !name) continue;

      person = {
        order,
        headquarters: "",
        division: "",
        office: "",
        team,
        teamKey: normalizeTeamKey(team),
        empNo: String(empNo),
        name,
        leaderFlag: "미해당",
        isLeader: false
      };
    }

    if (person) result.push(person);
  }

  result.sort((a, b) => Number(a.order) - Number(b.order));

  return result;
}

function splitPastedLine(line) {
  if (line.includes("\t")) {
    return line.split("\t");
  }

  const commaCols = line.split(",");
  if (commaCols.length >= 4) {
    return commaCols;
  }

  return line.split(/\s{2,}/);
}

function isHeaderRow(cols) {
  const joined = cols.join("").replace(/\s+/g, "");

  const hasOrder = joined.includes("순번");
  const hasName = joined.includes("성명");
  const hasEmp = joined.includes("사번");
  const hasTeam = joined.includes("팀") || joined.includes("팀명");

  return hasOrder && hasName && hasEmp && hasTeam;
}

async function applyPastedParticipants() {
  try {
    ensureFirebaseReady();
    requireSelectedTraining();

    const text = $("pasteBox").value;
    const list = parsePastedText(text);

    if (list.length === 0) {
      alert("반영할 참석자 데이터가 없습니다. 8개 열 형식인지 확인해주세요.");
      return;
    }

    const startDate = kstDateTimeLocalToDate($("startAt").value);
    const endDate = kstDateTimeLocalToDate($("endAt").value);

    const finalParticipants = mergeParticipantLists(participants, list);
    const teamInfos = getTeamInfosFromParticipants(finalParticipants);

    const conflicts = await findDuplicateTeamConflicts({
      excludeTrainingId: selectedTrainingId,
      startDate,
      endDate,
      teamInfos
    });

    if (conflicts.length > 0) {
      alert(buildConflictMessage(conflicts));
      return;
    }

    const ok = confirm(
      `${list.length}명의 참석자 명단을 현재 선택된 훈련에 저장할까요?\n\n` +
      `동일한 사번이 이미 있으면 조직, 팀, 성명, 팀장여부는 갱신됩니다.\n` +
      `기존 출석 기록은 유지됩니다.`
    );

    if (!ok) return;

    await saveParticipantsInBatches(list);
    await updateTrainingTeamInfo(finalParticipants);

    $("pasteBox").value = "";
    setMessage("memberMessage", `${list.length}명의 참석자 명단을 저장했습니다. 링크와 대시보드도 갱신되었습니다.`, "ok");
  } catch (err) {
    if (err.message === "훈련 미선택" || err.message === "Firebase 연결 실패") return;
    handleFirestoreError(err, "참석자 저장");
  }
}

async function saveParticipantsInBatches(list) {
  const chunkSize = 450;

  for (let i = 0; i < list.length; i += chunkSize) {
    const chunk = list.slice(i, i + chunkSize);
    const batch = db.batch();

    chunk.forEach((person) => {
      const safeEmpNo = makeSafeDocId(person.empNo);
      const ref = participantsRef().doc(safeEmpNo);

      batch.set(ref, {
        order: person.order,
        headquarters: person.headquarters || "",
        division: person.division || "",
        office: person.office || "",
        team: person.team,
        teamKey: normalizeTeamKey(person.team),
        empNo: person.empNo,
        name: person.name,
        leaderFlag: person.leaderFlag || "미해당",
        isLeader: person.isLeader === true,
        trainingId: selectedTrainingId,
        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
      }, { merge: true });
    });

    await batch.commit();
  }
}

async function addParticipantManually() {
  try {
    ensureFirebaseReady();
    requireSelectedTraining();

    const nextOrder = participants.length + 1;

    const headquarters = prompt("본부를 입력하세요. 예: 연구개발본부");
    if (headquarters === null) return;

    const division = prompt("사업부를 입력하세요. 없으면 - 입력");
    if (division === null) return;

    const office = prompt("실을 입력하세요. 예: R&D기획실");
    if (!office) return;

    const team = prompt("팀을 입력하세요.");
    if (!team) return;

    const empNo = prompt("사번을 입력하세요.");
    if (!empNo) return;

    const name = prompt("성명을 입력하세요.");
    if (!name) return;

    const leaderFlagRaw = prompt("팀장여부를 입력하세요. 팀장이면 해당, 아니면 미해당", "미해당");
    if (leaderFlagRaw === null) return;

    const startDate = kstDateTimeLocalToDate($("startAt").value);
    const endDate = kstDateTimeLocalToDate($("endAt").value);

    const newPerson = {
      order: nextOrder,
      headquarters,
      division,
      office,
      team,
      teamKey: normalizeTeamKey(team),
      empNo: String(empNo),
      name,
      leaderFlag: isLeaderFlag(leaderFlagRaw) ? "해당" : "미해당",
      isLeader: isLeaderFlag(leaderFlagRaw)
    };

    const finalParticipants = mergeParticipantLists(participants, [newPerson]);
    const teamInfos = getTeamInfosFromParticipants(finalParticipants);

    const conflicts = await findDuplicateTeamConflicts({
      excludeTrainingId: selectedTrainingId,
      startDate,
      endDate,
      teamInfos
    });

    if (conflicts.length > 0) {
      alert(buildConflictMessage(conflicts));
      return;
    }

    await participantsRef().doc(makeSafeDocId(empNo)).set({
      ...newPerson,
      trainingId: selectedTrainingId,
      updatedAt: firebase.firestore.FieldValue.serverTimestamp()
    }, { merge: true });

    await updateTrainingTeamInfo(finalParticipants);

    setMessage("memberMessage", "참석자 1명을 추가했습니다.", "ok");
  } catch (err) {
    if (err.message === "훈련 미선택" || err.message === "Firebase 연결 실패") return;
    handleFirestoreError(err, "참석자 추가");
  }
}

